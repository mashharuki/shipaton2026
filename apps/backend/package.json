{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply seatsignal-db --local",
    "generate:datasets": "tsx scripts/generate-datasets.ts",
    "push:datasets": "tsx scripts/push-datasets-to-kv.ts",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "1.5.1",
    "hono": "^4.12.33",
    "shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "tsx": "4.23.5",
    "vitest": "4.1.10",
    "wrangler": "^4.110.0",
    "yaml": "2.9.0"
  }
}
