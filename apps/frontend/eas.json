        "EXPO_PUBLIC_TERMS_OF_SERVICE_URL": "https://mashharuki.github.io/seat-signal-legal/terms.html",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "avp.104.106.107@ae.auone-net.jp"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
